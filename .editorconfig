root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{xml,html}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Örnek çıktıları (examples/**/*.out) programın gerçek stdout'unun bayt-bayt kopyasıdır:
# satır sonu boşlukları ve son satır sonu, çıktının parçasıdır -- editör dokunmasın.
[*.out]
trim_trailing_whitespace = false
insert_final_newline = false

[*.{json,js,css}]
indent_size = 2
