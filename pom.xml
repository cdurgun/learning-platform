<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.cdurgun</groupId>
    <artifactId>learning-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>learning-platform</name>
    <description>Çok dilli Java öğrenim platformu</description>

    <properties>
        <java.version>21</java.version>
        <commonmark.version>0.22.0</commonmark.version>
        <openhtmltopdf.version>1.1.74</openhtmltopdf.version>
        <jsoup.version>1.23.1</jsoup.version>
    </properties>

    <dependencies>
        <!-- Web + View -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- spring-mvc kategorisi, Validation & Exception Handling konusu için: jakarta.validation
             (@NotBlank, @Email, @Valid) gerçek mekanizmayla anlatılsın diye eklendi. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Opsiyonel kullanıcı kimlik doğrulaması: session-based form login (bkz.
             SecurityConfig). JWT/OAuth2 bilinçli olarak eklenmedi, proje sunucu
             tarafında render edilen bir Thymeleaf uygulaması: session-based auth
             ilk sürüm için yeterli ve daha basit. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Migrations (Boot 4: Flyway has its own starter). Flyway 10+ splits database-specific
             support out of flyway-core, so PostgreSQL support must be added explicitly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Markdown -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <!-- h2 başlıklarına otomatik id vermek için — sağdaki "Bu sayfada" TOC'unun linkleri
             bu id'lere gidiyor (bkz. MarkdownService). -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-heading-anchor</artifactId>
            <version>${commonmark.version}</version>
        </dependency>

        <!-- Boilerplate azaltma -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Faz 77: her konu için "PDF İndir" özelliği. Pure-Java (native binary/wkhtmltopdf
             gerektirmez — Docker/Render deploy'una uygun), aktif geliştirilen io.github.*
             namespace altında (com.openhtmltopdf grubu 1.0.10'da donmuş, 4+ yıl güncellenmemiş
             — bkz. PdfExportService javadoc'u). PdfExportService, MarkdownService.render()
             çıktısını (web sayfasıyla AYNI contentHtml) ayrı bir print-only Thymeleaf
             template'i (templates/topic-pdf.html) ile sarıp bu kütüphaneyle PDF'e çeviriyor. -->
        <dependency>
            <groupId>io.github.openhtmltopdf</groupId>
            <artifactId>openhtmltopdf-pdfbox</artifactId>
            <version>${openhtmltopdf.version}</version>
        </dependency>
        <!-- openhtmltopdf'in kendi jsoup-tabanlı DOM converter modülü 1.0.1'de kaldırıldı
             (resmi wiki: "This module is now removed") — güncel yöntem: HTML'i jsoup ile
             LENIENT (HTML5, CommonMark çıktısındaki olası küçük düzensizliklere — kapatılmamış
             br etiketi, kaçışsız "&" vb. — toleranslı) ayrıştırıp org.jsoup.helper.W3CDom ile
             W3C Document'e çevirmek, sonra builder.withW3cDocument(doc, baseUri) ile vermek
             (openhtmltopdf'in kendi XML parser'ı olan withHtmlContent(String,String) yerine —
             o, sıkı/well-formed XHTML bekliyor, gerçek dünya HTML'i için risklidir). -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>${jsoup.version}</version>
        </dependency>

        <!-- Dev/Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <!-- Boot 4: MockMvc'nin `@AutoConfigureMockMvc`'ı artık `spring-boot-starter-test`'te
             DEĞİL, ayrı bir `spring-boot-starter-webmvc-test` starter'ında (bkz.
             `AuthenticationFlowTest`, paket `org.springframework.boot.webmvc.test.autoconfigure`
             altına taşındı). Bu starter `spring-boot-starter-test`'i zaten transitive
             olarak içeriyor (JUnit/AssertJ/Mockito dahil), bu yüzden ayrı bir
             `spring-boot-starter-test` bağımlılığına gerek yok. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
